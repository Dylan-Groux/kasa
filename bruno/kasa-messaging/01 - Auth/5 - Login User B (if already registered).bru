meta {
  name: 5 - Login User B (if already registered)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "bruno-b@kasa-test.local",
    "password": "Password123!"
