meta {
  name: 1 - Register User A
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "bruno-a@kasa-test.local",
    "password": "Password123!",
    "name": "Bruno Test A"
  }
}

script:post-response {
  if (res.getStatus() === 201 || res.getStatus() === 200) {
    const data = res.getBody();
    bru.setEnvVar("tokenA", data.token);
    bru.setEnvVar("userAId", data.user.id);
  }
}

tests {
  test("returns a token and a user", function () {
    const data = res.getBody();
    expect(res.getStatus()).to.be.oneOf([200, 201]);
    expect(data).to.have.property("token");
    expect(data.user).to.have.property("id");
  });
}
